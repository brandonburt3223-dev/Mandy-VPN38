{
  "manifest_version": 3,
  "name": "Mandy VPN",
  "version": "1.0.0",
  "description": "A blue-and-pink browser proxy controller. Requires your own HTTPS proxy server.",
  "permissions": ["proxy", "storage"],
  "action": {
    "default_title": "Mandy VPN",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}